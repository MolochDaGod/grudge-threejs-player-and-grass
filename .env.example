# ─── Public values exposed to the client bundle (Vite VITE_* prefix) ────────
# These mirror existing Grudge Studio infrastructure — they are NOT secrets.
VITE_GRUDGE_API_URL=https://api.grudge-studio.com
VITE_GRUDGE_ID_URL=https://id.grudge-studio.com
VITE_ASSETS_URL=https://assets.grudge-studio.com
VITE_OBJECTSTORE_URL=https://objectstore.grudge-studio.com

# ─── Server-side values used ONLY by scripts/upload-r2.mjs ──────────────────
# Pull from Cloudflare dashboard → R2 → Manage R2 API Tokens.
# Bucket grudge-assets is shared with the rest of Grudge Studio. DO NOT commit
# real values here — copy this file to `.env` (gitignored) and fill in.
CF_ACCOUNT_ID=
OBJECT_STORAGE_BUCKET=grudge-assets
OBJECT_STORAGE_KEY=
OBJECT_STORAGE_SECRET=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_PUBLIC_URL=https://assets.grudge-studio.com
