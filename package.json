{
  "name": "grudge-threejs-player-and-grass",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Three.js player + grass scene wired up to load Grudge Studio race prefab characters with equipment toggling and a Unity-style controller.",
  "scripts": {
    "convert:races": "node scripts/convert-races.mjs",
    "convert:anims": "node scripts/convert-anims.mjs",
    "convert:all": "node scripts/convert-races.mjs && node scripts/convert-anims.mjs",
    "serve": "npx serve .",
    "test:install": "playwright install chromium",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1"
  },
  "dependencies": {
    "serve": "^14.2.6"
  }
}
