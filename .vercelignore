# ── Legacy CC3 character GLBs (NOT used by the current Bip001 race pipeline)
# These were 15-35 MB each and would push the deploy past Vercel's limits.
# The active deployment only needs ./character/races/ + ./character/races/anims/.
character/*.glb

# ── Raw race FBX masters ── the Player loads the converted GLBs in
# character/races/<PREFIX>_Characters.glb; the source FBXs sit alongside
# them only for re-conversion convenience.
character/races/*.fbx
character/races/anims/*.fbx

# ── Dev junk
node_modules
.history
.local
.canvas
.agents
artifacts
playwright-report
test-results
.playwright

# ── Tests + tooling that the runtime doesn't need at request time. We do
# NOT ignore package.json / package-lock.json / scripts/ / vite.config.ts /
# tsconfig.json anymore because vercel.json now runs `npm run build` to
# regenerate dist/ — stripping those files at upload time would make the
# build fail with `npm error enoent Could not read package.json`.
tests
playwright.config.js

# ── Orphan UI / dev pages NOT linked from the active page. Keep
# mainpanel.html (linked from src/index.html as "Open Full Main Panel").
characterstats.html
client-portal.html
pullobjstore.html
UIlayer.html

# ── README, LICENSE etc.
README.md
LICENSE.txt
