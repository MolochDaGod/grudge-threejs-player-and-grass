# Dependencies / build artifacts
node_modules/
.vercel/
.cache/

# Environment
.env
.env.local
.env.*.local

# OS / editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/
.history/
*.log

# Playwright test artifacts
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Source FBX files — the runtime only consumes the converted GLBs, and FBX
# inputs are tracked in the Asset-Rig-Editor / variant-pipeline repos.
*.fbx
*.FBX

# Legacy CC4 / Mixamo character GLBs (~500 MB total) live at the root of
# character/. Skip them so the repo stays small — the 6 Bip001 race prefab
# GLBs live under character/races/ and are the only ones we ship.
character/*.glb

# But keep race prefab GLBs (the actual default characters).
!character/races/
!character/races/*.glb
!character/races/anims/
!character/races/anims/*.glb

# Bulk Unity controller animation pack (1.5+ GB extracted). The runtime
# loads paths under /Character-Animator-Mapper/... only in dev (Vite serves
# the folder live via the grudgeCharacterAssets plugin); we never deploy
# the raw FBXs to Vercel.
Character-Animator-Mapper.zip
Character-Animator-Mapper/
